# Copy to .env and fill in real values. Never commit .env.

# Generate a key with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=replace-me-with-a-generated-secret-key

# "true" for local development, "false" in production.
DJANGO_DEBUG=true

# Comma-separated hostnames the site may serve, e.g. "example.com,www.example.com".
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Optional. Per-IP request cap for POST /api/log/ per minute (0 disables).
#DJANGO_API_RATE_LIMIT_PER_MINUTE=60

# Optional, production only (DJANGO_DEBUG=false). HSTS max-age in seconds;
# raise to 31536000 once HTTPS is stable, then consider enabling preload.
#DJANGO_SECURE_HSTS_SECONDS=3600
#DJANGO_SECURE_HSTS_PRELOAD=false
